{
  "name": "aging-assist",
  "version": "0.1.0",
  "description": "Vue 3 senior-friendly accessibility plugin for Chinese websites, with script embed, text-to-speech, large captions, high contrast and page zoom.",
  "type": "module",
  "main": "./dist/aging-assist.iife.js",
  "module": "./dist/aging-assist.es.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/aging-assist.iife.js",
  "jsdelivr": "./dist/aging-assist.iife.js",
  "sideEffects": [
    "./dist/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/aging-assist.es.js",
      "default": "./dist/aging-assist.iife.js"
    },
    "./dist/style.css": "./dist/style.css",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "适老化",
    "无障碍",
    "老年人",
    "网站适老化",
    "accessibility",
    "a11y",
    "senior-friendly",
    "elderly",
    "assistive-technology",
    "vue3",
    "vue",
    "script",
    "text-to-speech",
    "large-text",
    "high-contrast"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/842200588/aging-assist.git"
  },
  "bugs": {
    "url": "https://github.com/842200588/aging-assist/issues"
  },
  "homepage": "https://github.com/842200588/aging-assist#readme",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.0"
  },
  "license": "MIT"
}
